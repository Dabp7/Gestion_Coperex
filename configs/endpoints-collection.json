{
  "info": {
    "name": "Coperex demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3002/coperex/v1"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@example.test\",\"password\":\"Demo-password-123!\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Filtered page",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/company/?category=Technology&sort=name_asc&limite=20"
      }
    },
    {
      "name": "Excel same page",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/company/report?category=Technology&sort=name_asc&limite=20"
      }
    }
  ]
}
